# Datos de DESARROLLO. Copiado de .env.example, pero apuntando al stack local.
#
# En realidad no hace falta editar esto: `npm run env:local` lo genera con las
# claves que imprime `supabase status`. Este archivo esta para que se entienda que
# espera cada variable.
#
# La app no arranca si VITE_SUPABASE_URL no es local mientras corre en modo
# development. Ver src/lib/supabase/env.ts.

# 'local' | 'demo' | 'prod'
#   local -> stack de Supabase en Docker (lo normal)
#   demo  -> sin base: todo en memoria, se pierde al recargar
#   prod  -> SOLO si de verdad querés escribir en la base real desde dev
VITE_DATA_ENV=local

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
