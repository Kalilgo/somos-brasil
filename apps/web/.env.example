# Datos de la app.
#
# NO copies esto a .env con los valores de produccion: en `npm run dev` la app se
# niega a arrancar si la URL no es local, justamente para que un descuido no te
# escriba en la base real. Para desarrollo, `npm run env:local` genera solo el
# .env.development con la URL y las claves del stack local.

# 'local' | 'demo' | 'prod'. En el build de produccion se ignora: ahi siempre es
# 'prod' si hay URL (ver src/lib/supabase/env.ts).
VITE_DATA_ENV=prod

# En produccion va la URL real del proyecto (Dashboard > Settings > API, o
# `supabase projects api-keys --project-ref <ref>`). En dev tiene que ser
# http://127.0.0.1:54321.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# La anon key es publica por diseno: viaja en el bundle y esta pensada para estar
# expuesta. Lo que protege los datos es RLS, no la clave.
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Opcional: clave pública VAPID para notificaciones push (Web Push).
# Si no se define, la app usa la clave de desarrollo que viene en el código.
VITE_VAPID_PUBLIC_KEY=

# Sin VITE_SUPABASE_* la app funciona en MODO DEMO: datos de ejemplo en memoria,
# los cambios no se persisten más allá del navegador.
